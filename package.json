{
  "name": "server-act-root",
  "private": true,
  "scripts": {
    "prepare": "vp config",
    "build": "vp run -r --cache build",
    "dev": "vp run -r --parallel dev",
    "test": "vp run -r test",
    "check": "vp run --filter './packages/*' --cache build && vp check",
    "format": "vp fmt",
    "sherif": "sherif",
    "changeset:add": "changeset add",
    "changeset:publish": "changeset publish",
    "changeset:version": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@chungwei/oxlint-config": "^0.2.0",
    "sherif": "^1.13.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.32.1",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "error"
    }
  }
}
